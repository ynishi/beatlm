# `check` is the definition of green. CI runs it and nothing else, so a gate
# added here is picked up there without a second edit.

set shell := ["bash", "-euo", "pipefail", "-c"]

default:
    @just --list

# Everything a change owes before it is handed over.
check: rust-fmt-check rust-clippy rust-test rust-doc wasm-check scripts-test deny

rust-fmt-check:
    cargo fmt --all -- --check

rust-clippy:
    cargo clippy --workspace --all-targets -- -D warnings

rust-test:
    cargo test --workspace

# The design lives in the crate docs, so a missing doc or a broken link is a
# broken design document, and fails like one.
rust-doc:
    RUSTDOCFLAGS="-D warnings -D missing_docs" cargo doc --workspace --no-deps

# The browser is a first-class target: the umbrella and the browser host must
# build for it on every change, not when someone gets round to the demo. A
# lint needs no wasm-bindgen command, so CI does not install one.
# Lints the umbrella and the browser host for wasm32-unknown-unknown.
wasm-check:
    cargo clippy -p beatlm -p beatlm-web --target wasm32-unknown-unknown -- -D warnings

# The scripts' own tests: what the local server maps a path to and what it
# refuses. The standard library only; `-B` leaves no bytecode in the tree.
scripts-test:
    python3 -B -m unittest discover -s scripts -p "test_*.py"

deny:
    cargo deny check

# Third-party weights are fetched on request, never by `check`, the build or a
# test. The script states the source, the terms and the notices.

# Fetches the Depth Anything V2 Small weights (Apache-2.0) into the gitignored
# models/, at a pinned commit, verified by sha256.
setup-depth-anything:
    bash scripts/setup-depth-anything.sh

# Runs the original implementation on a fixed input and writes the encoder
# features and the depth it predicts next to the weights, for the port to be
# compared with. Needs `uv`; builds an isolated Python environment with torch.
# Run `just setup-depth-anything` first. `size` is the input's side in pixels,
# a multiple of 14: 518, the side the position embedding is stored for, writes
# reference/, any other reference/<size>/. `just reference-depth-anything 266`
# and `just reference-depth-anything size=266` both work: just passes the
# second to the parameter as the text `size=266`, and the prefix is dropped.
reference-depth-anything size="518":
    uv run --isolated --no-project scripts/reference/depth_anything_v2.py --size {{trim_start_match(size, "size=")}}

# The browser host (crates/beatlm-web). Its glue is generated by the
# wasm-bindgen command, which must be the exact version of the wasm-bindgen
# crate in Cargo.lock; `setup-web` installs that version, and `build-web`
# refuses any other. Neither is part of `check`.
web_out := "target/beatlm-web"
# The wasm-bindgen version Cargo.lock pins; empty when it pins none.
wasm_bindgen_version := `awk '/^name = "wasm-bindgen"$/ { getline; gsub(/"/, "", $3); print $3; exit }' Cargo.lock`

# It goes into cargo's bin directory (`$CARGO_HOME/bin`, which `cargo install`
# uses).
# Installs wasm-bindgen-cli at the wasm-bindgen version Cargo.lock pins.
setup-web:
    #!/usr/bin/env bash
    set -euo pipefail
    version="{{wasm_bindgen_version}}"
    test -n "$version" || { echo "setup-web: no wasm-bindgen in Cargo.lock" >&2; exit 1; }
    cargo install wasm-bindgen-cli --version "$version" --locked

# The module, its JavaScript glue and index.html go into {{web_out}}, which
# the `target` entry in .gitignore covers.
# Builds the browser host for wasm32 in release, with its glue and page.
build-web:
    #!/usr/bin/env bash
    set -euo pipefail
    want="{{wasm_bindgen_version}}"
    test -n "$want" || { echo "build-web: no wasm-bindgen in Cargo.lock" >&2; exit 1; }
    have="$(wasm-bindgen --version 2>/dev/null | awk '{ print $2 }' || true)"
    if [ "$have" != "$want" ]; then
        echo "build-web: needs the wasm-bindgen command at $want (found: ${have:-none}); run 'just setup-web'" >&2
        exit 1
    fi
    cargo build -p beatlm-web --release --target wasm32-unknown-unknown
    target_dir="$(cargo metadata --format-version 1 --no-deps | python3 -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])')"
    mkdir -p {{web_out}}
    wasm-bindgen --target web --no-typescript --out-dir {{web_out}} "$target_dir/wasm32-unknown-unknown/release/beatlm_web.wasm"
    cp crates/beatlm-web/index.html {{web_out}}/index.html
    echo "build-web: wrote {{web_out}}; serve it with 'just serve-web'"

# One origin serves the page at / and the models directory at /models/, so the
# page fetches the weights and references without copying them into
# {{web_out}}. The models directory is BEATLM_MODELS_DIR, or models/ at the
# workspace root: the rule the native tests read it by, so a worktree points
# the variable at the main checkout's. Without it the synthetic workload still
# runs. scripts/serve_web.py says what it refuses (traversal, listings, any
# method but GET and HEAD) and why a plain static server is enough.
# Serves the built page and the models directory on 127.0.0.1 only.
serve-web port="8000":
    #!/usr/bin/env bash
    set -euo pipefail
    test -f {{web_out}}/index.html || { echo "serve-web: nothing in {{web_out}}; run 'just build-web'" >&2; exit 1; }
    models="${BEATLM_MODELS_DIR:-models}"
    echo "serve-web: open http://127.0.0.1:{{port}}/?frames=600&latency=2 (synthetic)"
    echo "serve-web:   or http://127.0.0.1:{{port}}/?model=depth&side=266 (Depth Anything V2 Small)"
    exec python3 scripts/serve_web.py --port {{port}} --page {{web_out}} --models "$models"

# One worktree per issue, cut from a freshly fetched origin/main.
worktree-new type slug:
    git fetch origin
    git worktree add .worktrees/{{slug}} -b {{type}}/{{slug}} origin/main
    cd .worktrees/{{slug}} && just branch-check

# Refuses main, and a branch that does not contain origin/main.
branch-check:
    #!/usr/bin/env bash
    set -euo pipefail
    branch="$(git rev-parse --abbrev-ref HEAD)"
    if [ "$branch" = "main" ]; then
        echo "branch-check: on main; cut a branch with 'just worktree-new'" >&2
        exit 1
    fi
    if git rev-parse --verify --quiet origin/main >/dev/null; then
        git merge-base --is-ancestor origin/main HEAD || {
            echo "branch-check: $branch does not contain origin/main; rebase or recut" >&2
            exit 1
        }
    fi
    echo "branch-check: $branch ok"

# Commit messages on this branch carry no AI attribution (CONTRIBUTING.md).
commit-msg-check:
    #!/usr/bin/env bash
    set -euo pipefail
    range="origin/main..HEAD"
    git rev-parse --verify --quiet origin/main >/dev/null || range="HEAD"
    if git log --format=%B "$range" | grep -inE '^(co-authored-by|signed-off-by):|generated with'; then
        echo "commit-msg-check: attribution lines found in $range" >&2
        exit 1
    fi
    echo "commit-msg-check: $range ok"

# The gate before a hand-over: run it after the last commit, over the tree
# that is actually handed over.
pre-push: branch-check commit-msg-check check
